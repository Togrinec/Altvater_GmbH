# ─────────────────────────────────────────────────────────────────────────────
# Altvater GmbH Website – Umgebungsvariablen
# Diese Datei als .env.local kopieren und Werte eintragen
# .env.local NIEMALS committen (ist in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# ── E-Mail Versand ────────────────────────────────────────────────────────────

# OPTION A: Resend (empfohlen für Vercel, kostenloser Plan reicht)
# Konto erstellen: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTION B: SMTP (IONOS, Strato, Gmail etc.)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@altvater.de
SMTP_PASS=IhrPasswort

# ── Allgemein ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.altvater.de

# Empfänger-Adresse für Kontaktanfragen
CONTACT_EMAIL=info@altvater.de
